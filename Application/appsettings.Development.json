{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "{{DATABASE_CONNECTION_STRING}}",
    "TesEncryption": "{{TES_ENCRYPTION_CONNECTION_STRING}}"
  },
  "Kundera": {
    "BaseUrl": "{{KUNDERA_BASE_URL}}",
    "Kundera_Service_Secret": "{{KUNDERA_SERVICE_SECRET}}",
    "Arch_Service_Secret": "{{ARCH_SERVICE_SECRET}}"
  },
  "ElasticApm": {
    "ServiceName": "arch",
    "LogLevel": "Debug",
    "ServerUrl": "{{ELASTIC_APM_SERVER_URL}}",
    "TransactionSampleRate": 1.0
  },
  "RabbitMQ": {
    "HostName": "{{RABBITMQ_HOST}}",
    "UserName": "{{RABBITMQ_USERNAME}}",
    "Password": "{{RABBITMQ_PASSWORD}}",
    "ExchangeName": "{{RABBITMQ_EXCHANGE_NAME}}"
  },
  "RateLimitDefault": {
    "MaxAllowedRequestInWindow": "60",
    "WindowsSize": "00:01:00",
    "Version": "60"
  }
}
