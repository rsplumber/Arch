<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- The Blazor admin panel's components live in the Admin RCL, so this Web host has no
             .razor files of its own. Opt in explicitly so the Blazor framework static web assets
             (e.g. _framework/blazor.web.js) are included and served. -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DotNetCore.CAP.PostgreSql" Version="10.0.1" />
        <PackageReference Include="DotNetCore.CAP.RabbitMQ" Version="10.0.1" />
        <PackageReference Include="Elastic.Apm.NetCoreAll" Version="1.34.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
        <PackageReference Include="Savorboard.CAP.InMemoryMessageQueue" Version="10.0.0" />
        <!-- Transitive vulnerability remediation: MongoDB.Driver (pulled in by Elastic.Apm.MongoDb,
             part of Elastic.Apm.NetCoreAll) drags in vulnerable SharpCompress/Snappier. Pin both to
             patched versions. GHSA-6c8g-7p36-r338 (SharpCompress, patched 0.48.0) and
             GHSA-pggp-6c3x-2xmx (Snappier, patched 1.3.1). -->
        <PackageReference Include="SharpCompress" Version="0.48.0" />
        <PackageReference Include="Snappier" Version="1.3.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Arch\Arch.csproj" />
      <ProjectReference Include="..\Data\Caching\Data.Caching.InMemory\Data.Caching.InMemory.csproj" />
      <ProjectReference Include="..\Data\Data.EF\Data.EF.csproj" />
      <ProjectReference Include="..\Libraries\Auth\Authorization.Kundera\Authorization.Kundera.csproj" />
      <ProjectReference Include="..\Libraries\Auth\Authorization.SimpleJwt\Authorization.SimpleJwt.csproj" />
      <ProjectReference Include="..\Libraries\Encryption\Encryption.Abstractions\Encryption.Abstractions.csproj" />
      <ProjectReference Include="..\Libraries\Encryption\Encryption.Archrypt\Encryption.Archrypt.csproj" />
      <ProjectReference Include="..\Libraries\EndpointResolvers\EndpointResolver.Graph.InMemory\EndpointResolver.Graph.InMemory.csproj" />
      <ProjectReference Include="..\Libraries\EventBus\EventBus.Cap\EventBus.Cap.csproj" />
      <ProjectReference Include="..\Libraries\LoadBalancer\LoadBalancer.Basic\LoadBalancer.Basic.csproj" />
      <ProjectReference Include="..\Libraries\Logging\Logging.Console\Logging.Console.csproj" />
      <ProjectReference Include="..\Libraries\Logging\Logging.Logstash\Logging.Logstash.csproj" />
      <ProjectReference Include="..\Libraries\RateLimit\RateLimit.ArchLimit\RateLimit.ArchLimit.csproj" />
      <ProjectReference Include="..\Libraries\RateLimit\RateLimit.Configuration\RateLimit.Configuration.csproj" />
      <ProjectReference Include="..\Admin\Admin.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\cert\" />
    </ItemGroup>


</Project>
